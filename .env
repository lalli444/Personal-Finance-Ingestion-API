# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Default for local running without Docker: SQLite
DATABASE_URL=sqlite:///./finance.db

# PostgreSQL settings (used when running with Docker Compose or standalone Postgres)
POSTGRES_DB=finance
POSTGRES_USER=financeuser
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_PORT=5432
# POSTGRES_URL=postgresql://financeuser:changeme_in_production@localhost:5432/finance

# ── API ────────────────────────────────────────────────────────────────────────
API_PORT=8000

# ── Ingestion limits ───────────────────────────────────────────────────────────
MAX_CSV_ROWS=50000
MAX_UPLOAD_SIZE_MB=10
